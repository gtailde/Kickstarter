$7e152637e430236b$exports = JSON.parse('{"en":{"brandTitle":"crazybaby","nav":{"specs":"specs","buyButton":"Buy","ourStory":"OUR STORY","aboutUs":"ABOUT US","features":"FEATURES","getInTouch":"GET IN TOUCH"},"heroSection":{"title":"Futuristic<br />Wireless<br />Speaker","description":"Luna\u2019s performance is balanced and smooth in all frequency ranges which makes the music both naturally pleasant and distinctly more layered."},"benefits":{"card1":{"title":"Futuristic Design","description":"To give Luna a truly flawless look, we specifically picked aircraft grade aluminum as its material and adopted both three-dimensional stretch-bending technology and a high precision cold forging technique."},"card2":{"title":"Tweeter Speaker System","description":"To deliver a more layered sound performance better than a sole full-range speaker, our team equipped Luna with one more tweeter speaker responsible for high-frequency sound independently."},"card3":{"title":"Multiroom System","description":"Luna is natively compatible with your home Wi-Fi. Set up multiple speakers in different rooms to expand your music experience into the entire house."},"card4":{"title":"Intuitive Lighting System","description":"An intuitive user interface allows you to adjust the hue and saturation of color for lighting that fits any mood and situation."}},"aboutUs":{"card1":{"title":"DESIGNED FOR THE FUTURE","description":"In 2014, a group of geeky industrial designers, engineering veterans and acoustic experts formed crazybaby. This is a bunch of passionate people who are crazy enough to think they can challenge the industry with disruptive audio products."},"card2":{"title":"Luna Eye","description":"Luna Eye is to the essence of this innovative light and audio system. It comprises an independent tweeter speaker, a light guiding component, a dome and a ring ornament."},"cardLink":"See more about us"},"feedback":{"card1":{"text":"It really took me by surprise honestly to have such full beautiful sound that coming out of this small compact device. And with the brush aluminum surface, it feels so familiar. Like my iPhone.","authorName":"Garrett Martin","authorPosition":"Creative Director"}},"mainFeatures":{"title":"FEATURES","connectivity":{"title":"Connectivity","item1":"Hands Free Wireless Audio","item2":"Bluetooth 4.0 LE","item3":"Wi-Fi 2.4 GHz (802.11 b/g/n)","item4":"Smart Multiroom System Set Up","item5":"Party Mode with 6.0 Units and above","item6":"MESHNET Multi Speaker Network"},"soundMusic":{"title":"Sound & Music","item1":"Feel-in-chest Base Power","item2":"Lossless Digital Audio Transmission","item3":"Easy & Stable Stereo Pairing","item4":"Crisp and Clear High Frequency Sound","item5":"Streams from Cloud Music and Local Library","item6":"Auto Music from Last Song Stopped"},"appFeatures":{"title":"App Features","item1":"Customize Music Schedule","item2":"Wake Up with Favorite Songs","item3":"Home Detection Auto Wake Up","item4":"Color Wheel"}},"contact":{"title":"DO YOU HAVE ANY QUESTIONS?","emailPlaceholder":"Your email","messagePlaceholder":"Your message...","sendButton":"Send"},"footer":{"copyright":"\xa9 2019 All rights reserved.","termsOfUse":"Terms of Use","privacyPolicy":"Privacy Policy"}},"ua":{"brandTitle":"crazybaby","nav":{"specs":"\u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438","buyButton":"\u041A\u0443\u043F\u0438\u0442\u0438","ourStory":"\u041D\u0410\u0428\u0410 \u0406\u0421\u0422\u041E\u0420\u0406\u042F","aboutUs":"\u041F\u0420\u041E \u041D\u0410\u0421","features":"\u041E\u0421\u041E\u0411\u041B\u0418\u0412\u041E\u0421\u0422\u0406","getInTouch":"\u0417\u0412\'\u042F\u0417\u0410\u0422\u0418\u0421\u042F"},"heroSection":{"title":"\u0424\u0443\u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u043D\u0430<br />\u0411\u0435\u0437\u0434\u0440\u043E\u0442\u043E\u0432\u0430<br />\u041A\u043E\u043B\u043E\u043D\u043A\u0430","description":"\u041F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u0456\u0441